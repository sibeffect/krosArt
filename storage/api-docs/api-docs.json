                    "200": {
                        "description": "Page HTML"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/email/verify/{id}/{hash}": {
            "get": {
                "tags": [
                    "Vérification e-mail"
                ],
                "summary": "Vérifier l'adresse e-mail (lien signé)",
                "operationId": "emailVerify",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "hash",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "E-mail vérifié"
                    }
                }
            }
        },
        "/email/verification-notification": {
            "post": {
                "tags": [
                    "Vérification e-mail"
                ],
                "summary": "Renvoyer l'e-mail de vérification",
                "operationId": "emailVerificationNotification",
                "responses": {
                    "302": {
                        "description": "E-mail de vérification renvoyé"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/two-factor-challenge": {
            "get": {
                "tags": [
                    "Two-factor"
                ],
                "summary": "Formulaire de défi 2FA (après connexion)",
                "operationId": "twoFactorChallengeForm",
                "responses": {
                    "200": {
                        "description": "Page HTML"
