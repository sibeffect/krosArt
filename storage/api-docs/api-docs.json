            "post": {
                "tags": [
                    "Two-factor"
                ],
                "summary": "Valider le code 2FA à la connexion",
                "operationId": "twoFactorChallengeStore",
                "requestBody": {
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "code": {
                                        "type": "string",
                                        "description": "Code TOTP"
                                    },
                                    "recovery_code": {
                                        "type": "string",
                                        "description": "Code de secours"
                                    }
                                }
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "302": {
                        "description": "Connexion finalisée"
                    }
                }
            }
        },
