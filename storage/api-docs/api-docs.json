{
    "openapi": "3.0.0",
    "info": {
        "title": "Krosart API",
        "description": "Documentation de l'API Krosart",
        "version": "1.0.0"
    },
    "paths": {
        "/login": {
            "get": {
                "tags": [
                    "Authentification"
                ],
                "summary": "Formulaire de connexion",
                "operationId": "loginForm",
                "responses": {
                    "200": {
                        "description": "Page HTML de connexion"
                    }
                }
            },
            "post": {
                "tags": [
                    "Authentification"
                ],
                "summary": "Connexion",
                "operationId": "loginStore",
                "requestBody": {
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    },
                                    "remember": {
                                        "type": "boolean",
                                        "default": false
                                    }
                                },
                                "required": [
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "302": {
                        "description": "Redirection après connexion (souvent vers /dashboard)"
                    },
                    "422": {
                        "description": "Identifiants invalides"
                    }
                }
            }
        },
        "/logout": {
            "post": {
                "tags": [
                    "Authentification"
                ],
                "summary": "Déconnexion",
                "operationId": "logout",
                "responses": {
                    "302": {
                        "description": "Redirection après déconnexion"
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ]
            }
        },
        "/register": {
            "get": {
                "tags": [
                    "Authentification"
                ],
                "summary": "Formulaire d'inscription",
                "operationId": "registerForm",
                "responses": {
                    "200": {
                        "description": "Page HTML d'inscription"
                    }
                }
            },
            "post": {
                "tags": [
                    "Authentification"
                ],
                "summary": "Inscription",
                "operationId": "registerStore",
                "requestBody": {
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "maxLength": 255
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password"
                                    }
                                },
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ]
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "302": {
                        "description": "Redirection après inscription"
                    },
                    "422": {
                        "description": "Erreur de validation"
                    }
                }
            }
        },
        "/forgot-password": {
            "get": {
                "tags": [
                    "Mot de passe"
                ],
                "summary": "Formulaire mot de passe oublié",
                "operationId": "forgotPasswordForm",
                "responses": {
                    "200": {
                        "description": "Page HTML"
                    }
                }
            },
            "post": {
                "tags": [
                    "Mot de passe"
                ],
                "summary": "Demande de lien de réinitialisation",
                "operationId": "forgotPasswordStore",
                "requestBody": {
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    }
                                },
                                "required": [
                                    "email"
                                ]
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "302": {
                        "description": "Lien de réinitialisation envoyé"
                    }
                }
            }
        },
        "/reset-password/{token}": {
            "get": {
                "tags": [
                    "Mot de passe"
                ],
                "summary": "Formulaire de nouveau mot de passe",
                "operationId": "resetPasswordForm",
                "parameters": [
                    {
                        "name": "token",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Page HTML"
                    }
                }
            }
        },
        "/reset-password": {
            "post": {
                "tags": [
                    "Mot de passe"
                ],
                "summary": "Enregistrer le nouveau mot de passe",
                "operationId": "resetPasswordStore",
                "requestBody": {
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "token": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password"
                                    }
                                },
                                "required": [
                                    "token",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ]
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "302": {
                        "description": "Mot de passe mis à jour"
                    }
                }
            }
        },
        "/email/verify": {
            "get": {
                "tags": [
